{
  "name": "shade-zcash-sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Shade API: invoices, jars, grants, webhooks, tags.",
  "license": "MIT",
  "author": "Billi (https://github.com/billi-x4)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billi-x4/Shade.git",
    "directory": "backend/sdk"
  },
  "homepage": "https://github.com/billi-x4/Shade/tree/main/backend/sdk#readme",
  "bugs": {
    "url": "https://github.com/billi-x4/Shade/issues"
  },
  "type": "module",
  "keywords": [
    "shade",
    "zcash",
    "zec",
    "payments",
    "invoices",
    "webhooks"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
