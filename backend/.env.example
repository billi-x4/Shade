# Shade backend configuration. Copy to backend/.env (never commit it).
#
# `npm run dev`, `npm start`, `npm run worker`, `db:migrate` and `scan:local` load backend/.env
# when it exists; a variable already set in the process environment wins. docker-compose.yml
# loads it into the migrate, api and worker containers, but points DATABASE_URL and
# DATABASE_URL_UNPOOLED at its bundled Postgres and blanks VIEWING_KEY_SEAL_PRIVATE_KEYS for
# migrate and api; only the worker also loads backend/.env.worker (see .env.worker.example).
# An empty value means "use the default".
#
# Production (NODE_ENV=production) refuses to start without APP_ORIGIN, DATABASE_URL,
# BETTER_AUTH_SECRET and SHADE_ENCRYPTION_KEY. It also needs mail that can be delivered:
# MAIL_TRANSPORT=resend with RESEND_API_KEY and a MAIL_FROM on a domain verified in Resend. The
# console transport set below is refused while email verification is on (the production
# default); AUTH_REQUIRE_EMAIL_VERIFICATION=false is for a local trial only. In development the
# secrets and a seal keypair are generated into backend/.data/dev-secrets.json.

# --- Runtime ---------------------------------------------------------------------------------
# development | test | production. Default development. The Docker image sets production.
# Outside Docker, set NODE_ENV=production for `npm start` and `npm run worker` (in the process
# environment, or by uncommenting the line below in a production backend/.env). Never leave an
# empty NODE_ENV= line: under docker compose it replaces the image's production with an empty
# value, which means development.
# NODE_ENV=production
# Bind address. Default 127.0.0.1 in development, 0.0.0.0 in production.
HOST=
PORT=8787
LOG_LEVEL=info

# --- Origins -----------------------------------------------------------------------------------
# Public web app origin: pay/view links, CSRF Origin check, auth base URL. Required in production.
# Default http://localhost:5173 (development also accepts http://127.0.0.1:5173).
APP_ORIGIN=
# Client IP for per-IP rate limits. TRUST_PROXY is the SPA proxy's header: none | x-forwarded-for
# (first hop) | x-real-ip | x-vercel-forwarded-for. Once EDGE_SHARED_SECRET is set it is trusted only
# on requests carrying the x-shade-edge secret; without the secret, on every request. Behind Vercel
# -> Railway, Railway's edge overwrites X-Forwarded-For and X-Real-IP with Vercel's address, so use
# x-vercel-forwarded-for, and only after the agents.md §12.8 check shows Vercel sets it.
TRUST_PROXY=none
# The backend host's own edge header, for requests without the edge secret (direct /v1 callers)
# or when the proxy's header is missing: none | x-forwarded-for | x-real-ip. Only on a host whose
# edge overwrites it on every request (Railway: x-real-ip); anywhere else callers can forge it.
TRUST_PROXY_DIRECT=none
# When set (16+ chars), /api/* requires the header x-shade-edge with this value, and proxy IP
# headers are trusted only on requests that carry it.
EDGE_SHARED_SECRET=

# --- Database ----------------------------------------------------------------------------------
# Postgres 15+ (pooled URL). Required in production and for the standalone worker. Empty in
# development: PGlite under backend/.data/pglite (single process; the worker runs inline).
DATABASE_URL=
# Direct (unpooled) URL, preferred by `npm run db:migrate` for its session lock.
DATABASE_URL_UNPOOLED=
# docker-compose.yml only: password of the bundled Postgres (default shade).
POSTGRES_PASSWORD=

# --- Secrets -----------------------------------------------------------------------------------
# 32+ characters. node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# 32 bytes, base64 (encrypts webhook signing secrets).
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SHADE_ENCRYPTION_KEY=
# Hosted detection seal keypair: `npm run -s keys:seal -w @shade/backend >> seal.env` (-s keeps
# npm's banner out of the file), then move its two lines and delete seal.env. The public key goes
# here: the API seals uploaded viewing keys with it (absent in production = hosted detection
# disabled). The private key VIEWING_KEY_SEAL_PRIVATE_KEYS opens them, so it goes only in the
# worker's environment, never in this file or on the API tier: backend/.env.worker under docker
# compose (see .env.worker.example). In development leave the public key empty too: a matching
# keypair is generated for the inline worker.
VIEWING_KEY_SEAL_PUBLIC_KEY=

# --- Zcash -------------------------------------------------------------------------------------
# Enabled networks (comma list). Add mainnet deliberately.
SHADE_NETWORKS=testnet
# lightwalletd / Zaino gRPC endpoints, tried in order on transport errors.
LIGHTWALLETD_TESTNET_URL=https://testnet.zec.rocks:443,https://zaino.testnet.unsafe.zec.rocks:443
LIGHTWALLETD_MAINNET_URL=https://zec.rocks:443,https://zec-node.cakewallet.com:443
# Confirmations before an invoice is paid (1..100). ZIP-315 recommends 10 for untrusted funds.
SHADE_MIN_CONFIRMATIONS_TESTNET=1
SHADE_MIN_CONFIRMATIONS_MAINNET=10
# Block explorer link templates shown in the desk (must contain {txid}).
EXPLORER_TX_URL_TESTNET=https://testnet.zecblock.com/tx/{txid}
EXPLORER_TX_URL_MAINNET=https://zecblock.com/tx/{txid}

# --- Worker ------------------------------------------------------------------------------------
# inline | off. inline runs the worker loops inside the API process (required with PGlite).
# Default inline in development, off in production (run `node src/bin/worker.ts` instead).
SHADE_WORKER=
# Seconds between detector and promotion passes (1..3600).
SHADE_SCAN_INTERVAL_SEC=20

# --- Webhooks ----------------------------------------------------------------------------------
# Development only: allow http:// and private/loopback webhook targets. Refused in production.
SHADE_WEBHOOK_ALLOW_PRIVATE=false

# --- Email -------------------------------------------------------------------------------------
# console (development: links are logged) | resend.
MAIL_TRANSPORT=console
# Sender, as addr@domain or Name <addr@domain>. Empty: Shade <no-reply@localhost>, which only the
# console transport can use. MAIL_TRANSPORT=resend needs a sender on a domain verified in Resend;
# localhost, reserved (.test, .example, .local, ...) and IP-literal domains are refused at boot.
MAIL_FROM=
# Required when MAIL_TRANSPORT=resend.
RESEND_API_KEY=
# true | false. Default true in production, false otherwise. Production refuses the console
# transport while verification is required.
AUTH_REQUIRE_EMAIL_VERIFICATION=

# --- Command-line tools (not read by the server) -----------------------------------------------
# scan:local — your merchant API key and full viewing key stay on your machine.
# SHADE_API_URL=http://localhost:5173
# SHADE_API_KEY=
# SHADE_UFVK=
# demo:agent / demo:receiver
# SHADE_AGENT_KEY=
# SHADE_WEBHOOK_SECRET=
