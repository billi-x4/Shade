{
  "name": "@shade/backend",
  "private": true,
  "type": "module",
  "description": "Shade API, background worker, migrations and Zcash integration.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/bin/server.ts",
    "start": "node --env-file-if-exists=.env src/bin/server.ts",
    "worker": "node --env-file-if-exists=.env src/bin/worker.ts",
    "db:migrate": "node --env-file-if-exists=.env src/bin/migrate.ts",
    "scan:local": "node --env-file-if-exists=.env src/bin/scan-local.ts",
    "keys:seal": "node src/bin/gen-seal-key.ts",
    "demo:agent": "node --env-file-if-exists=.env sdk/examples/agent.ts",
    "demo:receiver": "node --env-file-if-exists=.env sdk/examples/receiver.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.3",
    "@ledgerhq/zcash-utils": "2.5.0",
    "@noble/hashes": "^2.4.0",
    "better-auth": "1.7.7",
    "hono": "^4.13.12",
    "ipaddr.js": "^2.5.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
